{
  "name": "jetbrains-replace-in-files",
  "displayName": "JetBrains Replace in Files for VS Code",
  "description": "Find and replace across your workspace with live results and code preview.",
  "version": "0.1.12",
  "publisher": "ziishaned",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:jetbrainsReplacer.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jetbrainsReplacer.open",
        "title": "Replace in Files",
        "category": "JetBrains Replace"
      }
    ],
    "keybindings": [
      {
        "command": "jetbrainsReplacer.open",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+r",
        "when": "!inDebugRepl"
      },
      {
        "command": "jetbrainsReplacer.quickOpen",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "activeWebviewPanelId == jetbrainsReplacer"
      },
      {
        "command": "jetbrainsReplacer.quickOpen",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == jetbrainsReplacer"
      },
      {
        "command": "jetbrainsReplacer.commands",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "activeWebviewPanelId == jetbrainsReplacer"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/ripgrep": "^1.18.0",
    "jsonc-parser": "^3.3.1",
    "plist": "^3.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "icon": "assets/replace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziishaned/jetbrains-replace-in-files-for-vs-code.git"
  }
}
